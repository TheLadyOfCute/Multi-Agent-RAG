# Multi-Agent RAG local environment
# Fill in the key values before calling model APIs. This file is ignored by git.

# ===== API Keys =====
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_PROVIDER=dashscope

# Optional. If left empty, the reranker falls back to local weighted ranking.
COHERE_API_KEY=
# ===== Docker Services =====
# These URLs match docker-compose.yml when the Python backend runs on the host.
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=multirag_neo4j

# If you later run the backend inside the same Docker Compose network, use:
# REDIS_URL=redis://redis:6379
# NEO4J_URI=bolt://neo4j:7687

# PostgreSQL is not provided by docker-compose.yml in this project right now.
DATABASE_URL=postgresql://localhost:5432/agentic_rag

# ===== Storage Paths =====
CHROMA_PERSIST_DIR=data/chroma_db
COLLECTION_NAME=documents
BM25_INDEX_PATH=data/bm25_index.pkl
UPLOAD_DIR=data/uploads

# ===== Model Configuration =====
LLM_MODEL=qwen3.6-plus
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1536

# ===== Chunking Configuration =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== Retrieval / Agent Configuration =====
RETRIEVAL_TOP_K=10
VALIDATOR_THRESHOLD=0.7
VALIDATOR_MAX_RETRIES=2
CRITIC_MAX_ITERATIONS=2

# ===== Cache Configuration =====
CACHE_ENABLED=true
CACHE_TTL=3600

# ===== API Server =====
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt

# ===== Performance =====
BATCH_SIZE=10
